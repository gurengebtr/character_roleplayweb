  "components": {
    "schemas": {
      "CharacterInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "system_prompt": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "System Prompt"
          },
          "opening_message": {
            "type": "string",
            "maxLength": 4000,
            "title": "Opening Message",
            "default": ""
          },
          "background": {
            "type": "string",
            "maxLength": 100000,
            "title": "Background",
            "default": ""
          },
          "phases": {
            "items": {
              "$ref": "#/components/schemas/Phase"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Phases"
          },
          "memory_enabled": {
            "type": "boolean",
            "title": "Memory Enabled",
            "default": true
          },
          "provider": {
            "type": "string",
            "enum": [
              "chatgpt",
              "endpoint"
            ],
            "title": "Provider",
            "default": "chatgpt"
          },
          "model": {
            "type": "string",
            "maxLength": 200,
            "title": "Model",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "system_prompt"
        ],
        "title": "CharacterInput"
      },
      "ConversationInput": {
        "properties": {
          "character_id": {
            "type": "string",
            "title": "Character Id"
          },
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "default": "New conversation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "character_id"
        ],
        "title": "ConversationInput"
      },
      "ConversationState": {
        "properties": {
          "phase_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phase Id"
          },
          "memory_note": {
            "type": "string",
            "maxLength": 4000,
            "title": "Memory Note",
            "default": ""
          },
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision"
        ],
        "title": "ConversationState"
      },
      "EndpointInput": {
        "properties": {
          "base_url": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Base Url"
          },
          "model": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Model"
          },
          "api_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Api Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base_url",
          "model"
        ],
        "title": "EndpointInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginInput": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginInput"
      },
      "Phase": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "prompt": {
            "type": "string",
            "maxLength": 8000,
            "title": "Prompt",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "Phase"
      },
      "TurnInput": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Content"
          },
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content",
          "request_id"
        ],
        "title": "TurnInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
