          },
          "query": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Query"
          },
          "background_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Background Version"
          },
          "memory_enabled": {
            "type": "boolean",
            "title": "Memory Enabled",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "character_id",
          "conversation_id",
          "query"
        ],
        "title": "Context"
      },
      "HTTPValidationError": {
        "properties": {
